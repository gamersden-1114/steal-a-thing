s:8px;background:#160d33;color:#fff;width:100%;box-sizing:border-box"><div style="display:flex;gap:6px;align-items:center"><input id="tmVal" type="number" min="1" max="9999" value="5" style="font:14px system-ui,sans-serif;padding:11px;border:0;border-radius:8px;background:#160d33;color:#fff;width:70px;box-sizing:border-box"><select id="tmUnit" style="font:13px system-ui,sans-serif;padding:11px;border:0;border-radius:8px;background:#160d33;color:#fff;flex:1"><option value="sec">sec (seconds)</option><option value="min" selected="">min (minutes)</option><option value="hour">hour (hours)</option></select></div><button class="ab" id="tmStart" style="background:#3ea0ff">Start timer</button><button class="ab" id="tmStop" style="background:#ff4d8d">Stop timer</button></div><div id="t3" class="col" style="display:none"><p style="margin:0;font:12px system-ui,sans-serif;color:#cfc3ff">Spawn destination</p><div class="tabs"><button class="tb on" id="stBase" data-st="base">Into base</button><button class="tb" id="stRunway" data-st="runway">On runway</button></div><p id="spawnHint" style="margin:0;font:11px system-ui,sans-serif;color:#cfc3ff">Places free into an empty base slot</p><button class="ab" data-spawn="0" style="background:#b8c0cc;color:#160d33">🐊 Sneaky Croco</button><button class="ab" data-spawn="1" style="background:#4fd16a;color:#082b12">🦈 Noodle Shark</button><button class="ab" data-spawn="2" style="background:#3ea0ff;color:#06203a">🐸 Laptopini Frogini</button><button class="ab" data-spawn="3" style="background:#c46bff;color:#160d33">🦋 Toaster Moth</button><button class="ab" data-spawn="4" style="background:#ff9d2e;color:#3a1c00">🦍 Disco Gorilla</button><button class="ab" data-spawn="all" style="background:#ffd23f;color:#160d33">Spawn ALL types</button><button class="ab" data-spawn="fill" style="background:#ff4d8d;color:#160d33">Fill base with Gorillas</button></div><button class="ab" data-a="0" style="background:#ff4d8d">Close</button></div></div>
