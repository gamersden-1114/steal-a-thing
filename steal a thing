<div id="t2" class="col" style="display:none"><input id="an" maxlength="80" placeholder="Type an announcement" autocomplete="off"><button class="ab" id="ans">Send announcement</button><button class="ab" id="gif" style="background:#ffd23f">Gift everyone 1,000 coins</button><hr style="border:0;border-top:1px solid #4a3a7e;margin:4px 0"><p>⏱ Timer</p><input id="tmText" class="inp" maxlength="60" placeholder="Timer text (e.g. Event ends in)" autocomplete="off"><div style="display:flex;gap:6px;align-items:center"><input id="tmVal" class="inp" type="number" min="1" max="9999" value="5" style="width:70px"><select id="tmUnit" class="inp" style="flex:1"><option value="sec">sec (seconds)</option><option value="min" selected="">min (minutes)</option><option value="hour">hour (hours)</option></select></div><button class="ab" id="tmStart" style="background:#3ea0ff">Start timer</button><button class="ab" id="tmStop" style="background:#ff4d8d">Stop timer</button></div>
<div id="t3" class="col" style="display: flex;"><p>Spawn destination</p><div class="tabs"><button class="tb on" id="stBase" data-st="base">Into base</button><button class="tb" id="stRunway" data-st="runway">On runway</button></div><p id="spawnHint">Places free into an empty base slot</p><p>Mutation</p><div class="tabs"><button class="tb on" id="mtNone" data-mt="none">None</button><button class="tb" id="mtRb" data-mt="rainbow">🌈 Rainbow (5x)</button><button class="tb" id="mtGold" data-mt="gold">🥇 Gold (1.25x)</button></div><button class="ab" data-spawn="0" style="background:#b8c0cc;color:#160d33">🐊 Sneaky Croco</button><button class="ab" data-spawn="1" style="background:#4fd16a;color:#082b12">🦈 Noodle Shark</button><button class="ab" data-spawn="2" style="background:#3ea0ff;color:#06203a">🐸 Laptopini Frogini</button><button class="ab" data-spawn="3" style="background:#c46bff;color:#160d33">🦋 Toaster Moth</button><button class="ab" data-spawn="4" style="background:#ff9d2e;color:#3a1c00">🦍 Disco Gorilla</button><button class="ab" data-spawn="5" style="background:linear-gradient(90deg,#fff,#3b9dff,#fff);color:#06203a">🐳 Boxotono Moby (Godly)</button><button class="ab" data-spawn="all" style="background:#ffd23f;color:#160d33">Spawn ALL types</button><button class="ab" data-spawn="fill" style="background:#ff4d8d;color:#160d33">Fill base with Gorillas</button></div>
<button class="ab" data-a="0" style="background:#ff4d8d">Close</button></div></div>
<div id="gate" style="display: none;"><div class="card">
<div id="m1" class="col"><b>Steal a Thing</b><button class="ab" id="bf" style="background:#3ea0ff" disabled="">Play with friends</button><button class="ab" id="br" disabled="">Play with random</button></div>
<div id="m2" class="col" style="display:none"><b>Play with friends</b><button class="ab" id="bc" disabled="">Create a game</button><p>Or enter the code from the top right of a friend's screen.</p><input id="ci" maxlength="4" autocomplete="off" autocapitalize="characters" spellcheck="false"><button id="cb" disabled="">Join</button><button class="ab" id="bb" style="background:#6b5bb3;color:#fff" disabled="">Back</button></div>
<div id="ce">Finding a lobby...</div></div></div>
<script>
const cv=document.getElementById('c'),g=cv.getContext('2d'),W=360,H=640,WW=640,WH=1500;cv.width=W;cv.height=H;
const F='Bungee, Impact, sans-serif';
const T=[{n:'Sneaky Croco',e:'🐊',p:25,i:1,c:'#b8c0cc',q:'Common'},{n:'Noodle Shark',e:'🦈',p:100,i:4,c:'#4fd16a',q:'Rare'},{n:'Laptopini Frogini',e:'🐸',p:400,i:14,c:'#3ea0ff',q:'Epic'},{n:'Toaster Moth',e:'🦋',p:1500,i:50,c:'#c46bff',q:'Legendary'},{n:'Disco Gorilla',e:'🦍',p:6000,i:180,c:'#ff9d2e',q:'Mythic'},{n:'Boxotono Moby',e:'🐳',p:50000,i:1000,c:'#7cc4ff',q:'Godly'}];
const GOD=T.map((t,i)=>t.q==='Godly'?i:-1).filter(i=>i>=0);
const pick=()=>{const r=Math.random();return r<.45?0:r<.75?1:r<.92?2:r<.985?3:4};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const ORDER=[3,7,2,6,1,5,0,4],TS=2.5,SP=60,TRAVEL=(WH-110)/SP;
let isOwner=true,lobby=null,code='',phase='solo',room=null,myBase=null,myPeer=null,claimAt=1e18,full=false,hue=Math.floor(Math.random()*360),coins=30,carry=null,msg='',msgT=0,time=0,rate=0,cx=0,cy=0,myLocked=false,lockCooldown=0;
const me={x:255,y:1240},mySl=Array(6).fill(null),mySlRb=Array(6).fill(false),gone=new Set(),walkers=[];
let runwaySpawns=[],spawnIdCounter=-1,spawnTarget='base',spawnMut='none';

const NPC_NAMES=['Alex','Jordan','Sam','Riley','Casey','Morgan','Quinn','Avery','Jamie','Taylor'];
const NPC_TRAITS=[
  {id:'anxious',speed:0.9},{id:'chill',speed:0.7},{id:'hype',speed:1.3},
  {id:'grumpy',speed:0.85},{id:'curious',speed:1.1},{id:'friendly',speed:1.0}
];
const THOUGHTS={
  idle:["Hmm, what should I grab next…","Is that a shark with noodles?","I need more coins.","This belt never stops.","Wonder if anyone's watching.","I should organize my base.","Brainrot economy is wild.","Did I lock my base?","These prices are getting ridiculous.","Maybe I should just watch for a bit."],
  nearPlayer:["Oh hey, another collector.","Don't steal my stuff… please.","Nice base you've got.","Are you going for the gorilla?","We're in this together, right?","That was a good grab.","Watch your step near the belt.","Competition is heating up."],
  seeRare:["WHOA is that legendary?!","No way — a mythic just dropped!","I need that. I NEED that.","Someone's about to snipe it.","Please don't let anyone take it…","That's the one. That's the one."],
  snow:["Brr, it's freezing out here.","Snow on the belt? Really?","My shoes are soaked.","Kinda cozy actually…","Who turned on winter mode?"],
  rain:["Great, now it's raining.","At least the belt still works.","I should've brought an umbrella.","Rain makes everything dramatic.","Splash zone near the conveyor."],
  rainbow:["Okay the rainbow is pretty ngl.","Nature is showing off.","Is this a good omen?","Rainbow means rare drops… right?","Someone take a screenshot."],
  tacos:["TACOS?! From the sky?!","This is the best event ever.","I'm not even mad.","Catch one for me!","My diet is officially over."],
  buy:["Nice pickup!","Oof, that cost a lot.","Smart buy.","I'd have gone for that too.","Your base is looking stacked.","Respect the grind."],
  baseFull:["Base is packed. Time to upgrade.","No more slots… tough choices.","Maybe clear something weak.","Full house. Feels good."],
  lowCoins:["Coins are tight right now.","Can't afford much…","Saving up for something big.","Every coin counts."],
  gift:["Free coins?! Yes!","Wait, are we all getting paid?","Best day ever!","Show me the money!","I'll spend it all on gorillas."],
  announce:["Did you see that announcement?","Ooh, news from the boss.","Wonder what that's about…","Everyone look up!","Okay, noted."],
  greeting:["Hey!","'Sup.","You new here?","Welcome to the chaos.","Another day, another brainrot."]
};
function pickThought(cat){const a=THOUGHTS[cat]||THOUGHTS.idle;return a[Math.random()*a.length|0]}
function makeNpc(i){
  const trait=NPC_TRAITS[i%NPC_TRAITS.length],name=NPC_NAMES[i%NPC_NAMES.length],hue=(i*67+30)%360,side=i%2;
  const x=side?80+Math.random()*120:440+Math.random()*120,y=120+Math.random()*(WH-240);
  return{id:i,name,trait:trait.id,speed:trait.speed,hue,x,y,tx:x,ty:y,thought:'',thoughtT:0,reactT:0,walkT:2+Math.random()*4,face:side?1:-1,energy:0.5+Math.random()*0.5,lastSeenRare:0,coins:120+Math.random()*350,carry:null,carryT:0,stash:[],chase:null,buyT:Math.random()*3,stealT:4+Math.random()*8,base:null,sl:Array(6).fill(null),slRb:Array(6).fill(false),stolenFromPlayer:false,locked:false,lockT:8+Math.random()*20};
}
// Assign NPCs to bases (all except player's base 3 in solo)
const NPC_BASE_ORDER=[0,1,2,4,5,6,7];
const npcs=Array.from({length:6},(_,i)=>makeNpc(i));
function assignNpcBases(){
  npcs.forEach((npc,i)=>{
    const bi=NPC_BASE_ORDER[i%NPC_BASE_ORDER.length];
    npc.base=bi;
    const b=B[bi];
    // Seed a couple starter brainrots so bases aren't empty
    const starters=[0,0,1,1,2];
    for(let k=0;k<2+Math.random()*2|0;k++){
      const t=starters[Math.random()*starters.length|0];
      if(npc.sl[k]==null){npc.sl[k]=t;npc.slRb[k]=Math.random()<0.08?1:0}
    }
    // Place NPC near their base
    npc.x=b.s?b.bx-30:b.bx+210;npc.y=b.by+150;npc.tx=npc.x;npc.ty=npc.y;
  });
}
function npcSay(npc,text,dur){npc.thought=text;npc.thoughtT=dur||3.5;npc.reactT=4+Math.random()*3}
function npcReactEvent(evName){
  const lines=THOUGHTS[evName];if(!lines)return;
  [...npcs].sort(()=>Math.random()-0.5).slice(0,2+Math.random()*2|0).forEach((npc,i)=>{
    setTimeout(()=>{
      if(npc.reactT>0)return;
      const line=lines[Math.random()*lines.length|0];
      if(npc.trait==='grumpy'&&Math.random()<0.4)npcSay(npc,"Ugh. "+line,3.2);
      else if(npc.trait==='hype')npcSay(npc,line.toUpperCase().replace(/[!.]/g,'!!!'),3.5);
      else if(npc.trait==='anxious')npcSay(npc,line+" …right?",3.5);
      else npcSay(npc,line,3.2);
    },300+i*600+Math.random()*400);
  });
}
function updateNpcs(dt){
  const now=performance.now()/1000;
  for(const npc of npcs){
    npc.reactT=Math.max(0,npc.reactT-dt);npc.thoughtT=Math.max(0,npc.thoughtT-dt);
    if(npc.thoughtT<=0)npc.thought='';
    const mode=densnap?'panic':ev.tacos>.3?'tacos':ev.rain>.3?'rain':ev.snow>.3?'snow':ev.rainbow>.3?'rainbow':null;
    if(mode!==npc.mode){
      npc.mode=mode;
      if(mode==='rain'){let best=null,bd=1e9;for(const b of B){const bx=b.s?b.bx-30:b.bx+210,by=b.by+150,d=Math.hypot(bx-npc.x,by-npc.y);if(d<bd){bd=d;best={x:bx,y:by}}}npc.tx=best.x;npc.ty=best.y;npc.walkT=99}
      else if(mode==='panic'){npc.tx=npc.x<WW/2?60:WW-60;npc.ty=clamp(npc.y+(Math.random()-.5)*400,60,WH-60);npc.walkT=99}
      else if(mode==='rainbow'){npc.tx=npc.x;npc.ty=npc.y;npc.walkT=99}
      else npc.walkT=.2;
    }
    npc.shiver=mode==='snow';npc.bounce=mode==='tacos';
    let mult=mode==='panic'?2:mode==='rain'?1.6:mode==='tacos'?1.4:mode==='snow'?.6:1;
    if(carry!=null&&carry.fromNpc===npc)mult=Math.max(mult,2.4);
    if(npc.stolenFromPlayer&&npc.carry!=null)mult=Math.max(mult,2.2);
    npc.coins+=3*dt;npc.buyT=Math.max(0,npc.buyT-dt);
    if(npc.carry!=null){
      npc.carryT-=dt;
      // Player can reclaim if they touch an NPC carrying THEIR stolen item
      if(npc.stolenFromPlayer&&Math.hypot(npc.x-me.x,npc.y-me.y)<28){
        if(carry!=null){
          // player already carrying — can't reclaim
        }else{
          const slot=mySl.findIndex((v,i)=>v==null&&!walkers.some(w=>w.base===myBase&&w.k===i));
          if(slot<0){say('Your base is full — clear a slot to reclaim!')}
          else{
            carry={t:npc.carry,rb:npc.carryRb||0,fromNpc:null,fromK:null,n:-(Date.now()%1e9),reclaim:true};
            say('Reclaimed your '+T[npc.carry].e+' from '+npc.name+'!');
            npcSay(npc,'Nooo my loot!',3);
            npc.carry=null;npc.carryRb=0;npc.stolenFromPlayer=false;npc.walkT=.5;
          }
        }
      }
      if(npc.carry!=null&&(Math.hypot(npc.tx-npc.x,npc.ty-npc.y)<12||npc.carryT<=0)){
        const slot=npc.sl.findIndex(v=>v==null);
        if(slot>=0){npc.sl[slot]=npc.carry;npc.slRb[slot]=npc.carryRb||0;npcSay(npc,npc.stolenFromPlayer?'Hehe, stolen goods!':'Added to my base!',3)}
        else{npc.stash.push(npc.carry);npcSay(npc,'Base full — stashed it',3)}
        if(npc.stolenFromPlayer)say(npc.name+' locked your '+T[npc.carry].e+' in their base!');
        npc.carry=null;npc.carryRb=0;npc.stolenFromPlayer=false;npc.walkT=.2;
      }
    }else if(npc.chase!=null){
      const it=beltItems().find(b=>b.n===npc.chase);
      if(!it||T[it.t].p>npc.coins){npc.chase=null;npc.walkT=.2}
      else{
        npc.tx=320;npc.ty=it.y;npc.walkT=99;mult=2.6;
        if(Math.hypot(320-npc.x,it.y-npc.y)<24){
          npc.coins-=T[it.t].p;gone.add(it.n);npc.carry=it.t;npc.carryT=14;npc.chase=null;
          const b=B[npc.base!=null?npc.base:Math.random()*B.length|0];npc.tx=b.s?b.bx-30:b.bx+210;npc.ty=b.by+150;npc.walkT=99;
        }
      }
    }else if((!mode||mode==='tacos')&&npc.buyT<=0){
      npc.buyT=1+Math.random()*1.5;
      if(Math.random()<(npc.trait==='hype'?.5:npc.trait==='grumpy'?.15:.3)){
        const opts=beltItems().filter(b=>T[b.t].p<=npc.coins&&Math.abs(b.y-npc.y)<350).sort((a,b)=>T[b.t].p-T[a.t].p);
        if(opts.length){npc.chase=opts[0].n;npcSay(npc,'I want that one!',2.5)}
      }
    }
    // NPC lock/unlock their own base
    npc.lockT=Math.max(0,npc.lockT-dt);
    if(npc.lockT<=0&&npc.base!=null){
      npc.lockT=12+Math.random()*25;
      const items=npc.sl.filter(v=>v!=null).length;
      if(npc.locked){
        if(items===0||Math.random()<0.35){npc.locked=false;if(Math.random()<.3)npcSay(npc,'Base unlocked.',2)}
      }else{
        if(items>=2&&Math.random()<(npc.trait==='anxious'?.7:npc.trait==='grumpy'?.5:.35)){
          npc.locked=true;
          if(Math.random()<.4)npcSay(npc,'Locking up!',2.5);
        }
      }
    }
    // Steal from player base (only if unlocked)
    npc.stealT=Math.max(0,npc.stealT-dt);
