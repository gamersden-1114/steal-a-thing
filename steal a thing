    const o=AC.createOscillator(),gn=AC.createGain();
    o.type='sawtooth';o.frequency.setValueAtTime(80,AC.currentTime);o.frequency.exponentialRampToValueAtTime(40,AC.currentTime+1.5);
    gn.gain.setValueAtTime(.15,AC.currentTime);gn.gain.exponentialRampToValueAtTime(.001,AC.currentTime+1.8);
