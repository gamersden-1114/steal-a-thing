const tacos=Array.from({length:36},()=>({x:Math.random()*W,y:Math.random()*H,s:90+Math.random()*120,r:Math.random()*6,v:(Math.random()-.5)*3,z:18+Math.random()*16}));
let AC=null,music=null,mStep=0,mNext=0;
let primed=false;
const unlock=()=>{if(!AC){try{AC=new (window.AudioContext||window.webkitAudioContext)()}catch(e){}}if(AC&&AC.state==='suspended')AC.resume();if(!primed&&window.speechSynthesis){primed=true;try{const u=new SpeechSynthesisUtterance(' ');u.volume=0;speechSynthesis.speak(u)}catch(e){}}};
addEventListener('pointerdown',unlock);addEventListener('keydown',unlock);
const MEL=[72,76,79,76,74,77,81,77,72,76,79,84,83,79,76,72],BAS=[48,0,55,0,50,0,57,0,48,0,55,0,55,0,52,0];
const MEL2=[79,76,72,76,77,74,71,74,76,79,84,79,77,76,74,72],BAS2=[53,0,60,0,55,0,62,0,53,0,60,0,55,0,59,0];
const LY=["Forecast says it's a crunchy day","Shells are swirling, hip hooray","Salsa clouds drift in the blue","Cheese and lettuce falling too","Grab your plate and hold it high","Taco storm across the sky","Every bite, a happy cheer","Taco weather's finally here","Crunch, crunch, taco crunch","Fill your plate and join the lunch","Sizzle, pop, a fiesta beat","Everybody's tapping their feet"];
const VOW={a:[800,1150,2800],e:[530,1840,2480],i:[270,2290,3010],o:[570,840,2410],u:[300,870,2240]};
const SYL=LY.map(l=>(l.toLowerCase().match(/[aeiouy]+/g)||[]).map(v=>VOW[v[0]]||VOW.i).slice(0,8));
let VO=null;
function voOut(){if(!VO){const inp=AC.createGain(),d=AC.createDelay(),fb=AC.createGain(),wet=AC.createGain();d.delayTime.value=.11;fb.gain.value=.35;wet.gain.value=.35;inp.connect(AC.destination);inp.connect(d);d.connect(fb);fb.connect(d);d.connect(wet);wet.connect(AC.destination);VO=inp}return VO}
let NB=null;
function voice(fs,hz,t,d){
  t+=(Math.random()-.5)*.03;
  const src=AC.createGain(),lp=AC.createBiquadFilter(),m=AC.createGain();lp.type='lowpass';lp.frequency.value=4200;src.gain.value=.5;
  [[-12,0],[0,.014],[12,.028]].forEach(([c,off],k)=>{
    const o=AC.createOscillator(),lf=AC.createOscillator(),lg=AC.createGain();
    o.type='sawtooth';o.detune.value=c+(Math.random()-.5)*10;
    o.frequency.setValueAtTime(hz*.97,t+off);o.frequency.exponentialRampToValueAtTime(hz,t+off+.09);
    lf.frequency.value=5+k*.35+Math.random()*.4;lg.gain.setValueAtTime(0,t);lg.gain.linearRampToValueAtTime(hz*.014,t+.28);
    lf.connect(lg);lg.connect(o.frequency);o.connect(src);o.start(t+off);lf.start(t+off);o.stop(t+d+.05);lf.stop(t+d+.05)});
  src.connect(lp);
  fs.forEach((fr,i)=>{const b=AC.createBiquadFilter();b.type='bandpass';b.frequency.value=fr*1.18;b.Q.value=6;const gg=AC.createGain();gg.gain.value=[1,.6,.3][i]*2.2;lp.connect(b);b.connect(gg);gg.connect(m)});
  m.gain.setValueAtTime(0,t);m.gain.linearRampToValueAtTime(.2,t+.07);m.gain.setValueAtTime(.2,t+d-.09);m.gain.linearRampToValueAtTime(0,t+d);
  m.connect(voOut());
  if(!NB){NB=AC.createBuffer(1,Math.floor(AC.sampleRate*.2),AC.sampleRate);const a=NB.getChannelData(0);for(let k=0;k<a.length;k++)a[k]=Math.random()*2-1}
  const ns=AC.createBufferSource(),hp=AC.createBiquadFilter(),ng=AC.createGain();ns.buffer=NB;hp.type='highpass';hp.frequency.value=2500;
  ng.gain.setValueAtTime(.07,t);ng.gain.exponentialRampToValueAtTime(.001,t+.12);ns.connect(hp);hp.connect(ng);ng.connect(voOut());ns.start(t);ns.stop(t+.15)}
let lyT0=0,lastLy=-1,lyricIdx=-1;
const lyrEl=document.getElementById('lyr'),l1=document.getElementById('l1'),l2=document.getElementById('l2');
function showLyric(i){lyrEl.style.display='block';l1.textContent='';LY[i].split(' ').forEach(w=>{const sp=document.createElement('span');sp.textContent=w+' ';l1.appendChild(sp)});l2.textContent=LY[(i+1)%LY.length]}
function tickLyric(){const n=l1.children.length,pr=((performance.now()-lyT0)%3200)/3200*1.1;for(let j=0;j<n;j++)l1.children[j].className=j<pr*n?'on':''}
function pickVoice(){const v=(speechSynthesis.getVoices()||[]).filter(x=>/^en/i.test(x.lang));let b=null,bs=-1;for(const x of v){let sc=0;if(/natural|neural|premium|enhanced/i.test(x.name))sc+=4;if(/en[-_]US/i.test(x.lang))sc+=2;if(/google|samantha|aria|jenny|zira|siri/i.test(x.name))sc+=1;if(/female|samantha|aria|jenny|zira|karen|moira|tessa|victoria|susan/i.test(x.name))sc+=2;if(sc>bs){bs=sc;b=x}}return b}
function sing(t){try{if(!window.speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t),v=pickVoice();if(v){u.voice=v;u.lang=v.lang}else u.lang='en-US';u.pitch=1.35;u.rate=.98;speechSynthesis.speak(u)}catch(e){}}
function tone(m,t,d,type,v){const o=AC.createOscillator(),gn=AC.createGain();o.type=type;o.frequency.value=440*Math.pow(2,(m-69)/12);gn.gain.setValueAtTime(v,t);gn.gain.exponentialRampToValueAtTime(.001,t+d);o.connect(gn);gn.connect(AC.destination);o.start(t);o.stop(t+d+.02)}
function startMusic(){unlock();if(!AC||music)return;mNext=AC.currentTime+.05;mStep=0;music=setInterval(()=>{while(mNext<AC.currentTime+.3){const sc=(mStep>>4)&1,mm=(sc?MEL2:MEL)[mStep%16],bb=(sc?BAS2:BAS)[mStep%16];tone(mm,mNext,.16,'square',.03);if(bb)tone(bb,mNext,.2,'triangle',.1);{const sy=SYL[(mStep>>4)%LY.length],st=mStep%16;if(st%2===0&&sy[st>>1])voice(sy[st>>1],440*Math.pow(2,(mm-69)/12),mNext,.34)}mNext+=.2;mStep++}},100)}
function stopMusic(){clearInterval(music);music=null;try{if(window.speechSynthesis)speechSynthesis.cancel()}catch(e){}}
const flakes=Array.from({length:90},()=>({x:Math.random()*W,y:Math.random()*H,r:1+Math.random()*2.5,s:30+Math.random()*50,p:Math.random()*6}));
function curEvents(){
  const nw=Date.now()/1000,out={},n=Math.floor(nw/EV_LEN),h=Math.sin(n*91.7)*43758.5453,q=h-Math.floor(h);
  if(q<=.55){const t=nw-n*EV_LEN;out[q<.2?'snow':q<.4?'rain':'rainbow']=Math.min(1,t/6,(EV_LEN-t)/6)}
  for(const id in forced){const f=forced[id];if(nw>=f.until){delete forced[id];continue}
    if(f.off){delete out[id];continue}
    out[id]=Math.max(out[id]||0,Math.min(1,(nw-f.start)/3,(f.until-nw)/3))}
  return out}
const keys={};let ptr=null;
addEventListener('keydown',e=>{if(document.activeElement.tagName!=='INPUT')keys[e.key.toLowerCase()]=1});
addEventListener('keyup',e=>keys[e.key.toLowerCase()]=0);
const pos=e=>{const r=cv.getBoundingClientRect();return{x:(e.clientX-r.left)*W/r.width,y:(e.clientY-r.top)*H/r.height}};
const REACH=70;
const PID=()=>myPeer||'me';
const mkWp=(base,k)=>{const b=B[base],q=b.sl[k];return[{x:320,y:b.by+150},{x:b.s?b.bx+20:b.bx+170,y:b.by+150},{x:q.x,y:q.y}]};
function applyBuy(ev){
  gone.add(ev.n);
  const w=walkers.find(w=>w.n===ev.n);
  if(w){
    if(ev.seq<w.seq||(ev.seq===w.seq&&ev.peer<=w.peer))return;
    if(w.peer===PID()&&ev.peer!==PID())coins+=T[w.t].p;
    walkers.splice(walkers.indexOf(w),1);
  }
  walkers.push({n:ev.n,t:ev.t,x:ev.x,y:ev.y,base:ev.base,k:ev.k,seq:ev.seq,peer:ev.peer,wp:mkWp(ev.base,ev.k),i:0});
}
const buyables=()=>beltItems().map(b=>({n:b.n,t:b.t,x:320,y:b.y})).concat(walkers.filter(w=>w.base!==myBase).map(w=>({n:w.n,t:w.t,x:w.x,y:w.y,w})));
function nearest(){let best=null,bd=REACH;for(const b of buyables()){const d=Math.hypot(b.x-me.x,b.y-me.y);if(d<bd){bd=d;best=b}}return best}
function buy(b){
  if(myBase==null)return;
  const t=T[b.t];
  if(coins<t.p){say('Need '+t.p+' coins');return}
  const k=mySl.findIndex((v,i)=>v==null&&!walkers.some(w=>w.base===myBase&&w.k===i));
  if(k<0){say('Your base is full');return}
  coins-=t.p;say((b.w?'Took ':'Bought ')+t.n);
  const ev={n:b.n,t:b.t,base:myBase,k,seq:b.w?b.w.seq+1:1,peer:PID(),x:Math.round(b.x),y:Math.round(b.y)};
  applyBuy(ev);if(room)room.emit('buy',ev).catch(()=>{});
}
addEventListener('keydown',e=>{if(e.key.toLowerCase()==='e'&&document.activeElement.tagName!=='INPUT'){const b=nearest();if(b)buy(b)}});
const joy={id:null,x:0,y:0},JC={x:64,y:560,r:44};let isTouch=matchMedia('(pointer:coarse)').matches;
function joyMove(e){const q=pos(e),vx=q.x-JC.x,vy=q.y-JC.y,d=Math.hypot(vx,vy)||1,m=Math.min(d,JC.r);joy.x=vx/d*m/JC.r;joy.y=vy/d*m/JC.r;if(Math.hypot(joy.x,joy.y)<.12){joy.x=0;joy.y=0}}
cv.addEventListener('pointerdown',e=>{
  {const q0=pos(e);if(isOwner&&q0.x<56&&q0.y>292&&q0.y<350){const a=document.getElementById('adm');a.style.display=a.style.display==='flex'?'none':'flex';refreshAdm();return}}
  if(e.pointerType==='touch'){isTouch=true;const q=pos(e);if(joy.id==null&&Math.hypot(q.x-JC.x,q.y-JC.y)<100){joy.id=e.pointerId;joyMove(e);cv.setPointerCapture(e.pointerId)}else{const wx=q.x+cx,wy=q.y+cy,b=buyables().find(b=>Math.hypot(wx-b.x,wy-b.y)<36);if(b){if(Math.hypot(b.x-me.x,b.y-me.y)<=REACH)buy(b);else say('Walk closer')}}}
  else{ptr=pos(e);cv.setPointerCapture(e.pointerId)}});
cv.addEventListener('pointermove',e=>{if(e.pointerId===joy.id)joyMove(e);else if(ptr&&e.pointerType!=='touch')ptr=pos(e)});
const up=e=>{if(e.pointerId===joy.id){joy.id=null;joy.x=joy.y=0}if(e.pointerType!=='touch')ptr=null};
addEventListener('pointerup',up);addEventListener('pointercancel',up);
const others=()=>room?room.peers().filter(p=>!p.sameTab&&p.kind==='viewer'):[];
const takenMap=()=>{const m={};others().forEach(p=>{const b=p.presence.base;if(typeof b==='number')m[b]=p});return m};
const typeAt=n=>{const h=Math.sin(n*127.1)*43758.5453,r=h-Math.floor(h);return r<.45?0:r<.75?1:r<.92?2:r<.985?3:4};
function beltItems(){const now=Date.now()/1000,o=[];for(let n=Math.floor((now-TRAVEL)/TS);n<=Math.floor(now/TS);n++){const y=60+(now-n*TS)*SP;if(y>WH-50||y<60||gone.has(n))continue;o.push({n,y,t:typeAt(n)})}return o}
function goBase(k){myBase=k;const b=B[k];me.x=b.s?b.bx-25:b.bx+215;me.y=b.by+150;say('You are in Base '+(k+1))}
function assign(){
  if(!room||performance.now()<claimAt)return;
  const mp=room.peers().find(p=>p.sameTab);if(!mp)return;myPeer=mp.peer;
  const tk=takenMap();
  if(myBase!=null){const c=tk[myBase];if(c&&c.peer<myPeer){myBase=null;mySl.fill(null);walkers.length=0;room.presence({base:null}).catch(()=>{})}else return}
  const f=ORDER.find(k=>!tk[k]);
  if(f==null){full=true;return}
  full=false;goBase(f);room.presence({base:f,h:hue}).catch(()=>{});
}
const newCode=()=>Array.from({length:4},()=>'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[Math.random()*32|0]).join('');
function begin(r,c,pub){
  room=r;code=c;phase='play';r.presence({pub:!!pub}).catch(()=>{});
  room.on('buy',m=>{const d=m.data;if(d&&typeof d.n==='number'&&typeof d.peer==='string'&&Number.isInteger(d.base)&&d.base>=0&&d.base<8&&Number.isInteger(d.k)&&d.k>=0&&d.k<6&&T[d.t]&&typeof d.seq==='number'&&isFinite(d.x)&&isFinite(d.y))applyBuy(d)});
  room.on('announce',m=>{const d=m.data;if(d&&typeof d.t==='string')showAnn(d.t.slice(0,80))});
  room.on('gift',m=>{const d=m.data;if(d&&Number.isFinite(d.n)&&d.n>0&&d.n<=100000&&typeof d.id==='string')gift(d.n,d.id)});
  room.on('ev',m=>{const d=m.data;if(d&&(d.id==='snow'||d.id==='rain'||d.id==='rainbow'||d.id==='tacos'||d.id==='none'))setForced({id:d.id,off:d.off===true})});
  room.onPeers(assign);claimAt=performance.now()+1800;setInterval(assign,1000);
  setInterval(()=>{if(room.connected())room.presence({x:Math.round(me.x),y:Math.round(me.y),sl:mySl.map(t=>t==null?-1:t)}).catch(()=>{})},100);
  lobby.presence({sess:c,pub:!!pub}).catch(()=>{});
}
async function tryCode(c){
  c=c.trim().toUpperCase();
  if(c.length<4)return 'Enter the 4-character code';
  let r;try{r=await lobby.join('g-'+c.toLowerCase())}catch(e){return 'Could not join, try again'}
  await new Promise(res=>setTimeout(res,1800));
  const o=r.peers().filter(p=>!p.isMe&&p.kind==='viewer');
  if(!o.length){r.leave().catch(()=>{});return 'Wrong code'}
  begin(r,c,o.some(p=>p.presence.pub));return '';
}
async function host(pub){const c=newCode();try{begin(await lobby.join('g-'+c.toLowerCase()),c,pub)}catch(e){return 'Could not create a game, try again'}return ''}
async function playRandom(){
  await new Promise(res=>setTimeout(res,1200));
  const cnt={};lobby.peers().forEach(p=>{const q=p.presence;if(!p.isMe&&p.kind==='viewer'&&q.pub&&typeof q.sess==='string')cnt[q.sess]=(cnt[q.sess]||0)+1});
  const open=Object.keys(cnt).filter(c=>cnt[c]<8).sort(()=>Math.random()-.5);
  for(const c of open){if(!await tryCode(c))return ''}
