// Expose spawn for console: spawn(0) ... spawn(4), spawnAll(), fillBase(4)
window.spawn=spawn;window.spawnAll=spawnAll;window.fillBase=fillBase;window.spawnOnRunway=spawnOnRunway;window.startDenSnap=startDenSnap;
window.setSnapEvents=(arr)=>{
  snapEvents=new Set((arr||[]).filter(e=>['snow','rain','rainbow','tacos'].includes(e)));
  document.querySelectorAll('#snapEvTabs .tb').forEach(x=>x.classList.toggle('on',snapEvents.has(x.dataset.se)));
};
window.toggleSnapEvent=e=>{
  if(snapEvents.has(e))snapEvents.delete(e);else if(['snow','rain','rainbow','tacos'].includes(e))snapEvents.add(e);
  document.querySelectorAll('#snapEvTabs .tb').forEach(x=>x.classList.toggle('on',snapEvents.has(x.dataset.se)));
};
window.setSpawnTarget=t=>{spawnTarget=t==='runway'?'runway':'base';
  const sb=document.getElementById('stBase'),sr=document.getElementById('stRunway'),h=document.getElementById('spawnHint');
  if(sb)sb.classList.toggle('on',spawnTarget==='base');
  if(sr)sr.classList.toggle('on',spawnTarget==='runway');
  if(h)h.textContent=spawnTarget==='runway'?'Drops onto the red conveyor — walk up and buy/steal it':'Places free into an empty base slot';
};
function refreshAdm(){const L={4:['❄️ Snow','snow'],6:['🌧️ Rain','rain'],7:['🌈 Rainbow','rainbow'],8:['🌮 Raining tacos','tacos']};document.querySelectorAll('#adm .ab').forEach(b=>{const l=L[b.dataset.a];if(l)b.textContent=l[0]+': '+(ev[l[1]]>0?'ON (tap to stop)':'OFF (tap for 60s)')})}
// ── Source code viewer ──
const codeBtn=document.getElementById('codeBtn');
const codeModal=document.getElementById('codeModal');
const codeArea=document.getElementById('codeArea');
const codeStatus=document.getElementById('codeStatus');
function showGameCode(){
  // Prefer original saved source if present; else live DOM
  let src='';
  try{
    const scripts=[...document.scripts].map(sc=>sc.src?('<!-- external: '+sc.src+' -->'):sc.textContent);
    src='<!DOCTYPE html>\n'+document.documentElement.outerHTML;
  }catch(e){src='Could not read source: '+e}
  codeArea.value=src;
  codeStatus.textContent=src.length.toLocaleString()+' characters';
  codeModal.classList.add('on');
  codeArea.scrollTop=0;
  setTimeout(()=>{try{codeArea.focus();codeArea.select()}catch(e){}},50);
}
codeBtn.onclick=e=>{e.stopPropagation();showGameCode()};
document.getElementById('codeClose').onclick=()=>codeModal.classList.remove('on');
document.getElementById('codeCopy').onclick=async()=>{
  const t=codeArea.value;
  try{
    await navigator.clipboard.writeText(t);
    codeStatus.textContent='✅ Copied to clipboard!';
  }catch(e){
    try{codeArea.select();document.execCommand('copy');codeStatus.textContent='✅ Copied!'}
    catch(e2){codeStatus.textContent='Select all (Ctrl/Cmd+A) then copy (Ctrl/Cmd+C)'}
  }
};
codeModal.addEventListener('click',e=>{if(e.target===codeModal)codeModal.classList.remove('on')});
addEventListener('keydown',e=>{if(e.key==='Escape')codeModal.classList.remove('on')});

let last=performance.now();
(function loop(n){const dt=Math.min(.05,(n-last)/1000);last=n;update(dt);draw();requestAnimationFrame(loop)})(last);
</script>
