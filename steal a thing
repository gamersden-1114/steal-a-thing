function updateDenSnap(dt){
  if(!densnap)return;
  const t=performance.now()/1000-densnap.t0;
  if(t<1.2)densnap.phase=0;
  else if(t<2.5)densnap.phase=1;
  else if(t<5.5)densnap.phase=2;
  else if(t<6.8)densnap.phase=3;
  else if(t<7.6){densnap.phase=4;densnap.shake=Math.max(densnap.shake,14);densnap.flash=1}
  else if(t<11){
    densnap.phase=5;densnap.shake=8*Math.max(0,1-(t-7.6)/3.4);
    if(Math.random()<0.4)densnap.particles.push({x:Math.random()*W,y:-10,vy:80+Math.random()*120,vx:(Math.random()-.5)*60,life:2,kind:Math.random()<.3?'brain':'coin'});
  }else if(t<13){densnap.phase=6;densnap.shake*=0.9}
  else{densnap=null;say('🕷️ Den Snap over — enjoy the chaos');return}
  densnap.flash=Math.max(0,densnap.flash-dt*2);densnap.shake*=0.92;
  densnap.walk=densnap.phase===2?Math.min(1,(t-2.5)/3):densnap.phase>2?1:0;
  densnap.hand=densnap.phase===3?Math.min(1,(t-5.5)/1.3):densnap.phase>=4?1:0;
  densnap.bob=densnap.phase===2?Math.sin(t*10)*4:0;
  if(t>=6.8&&!densnap.rewarded){
    densnap.rewarded=true;coins+=5000;
    for(let i=0;i<3;i++)setTimeout(()=>spawnOnRunway(2+Math.min(2,i)),i*200);
    const k=mySl.findIndex(v=>v==null);
    if(k>=0){mySl[k]=4;mySlRb[k]=false;say('🦍 Sammy gifted you a Disco Gorilla!')}
    for(const id of snapEvents){const d={id};setForced(d);if(room)room.emit('ev',d).catch(()=>{})}
    if(snapEvents.size)say('🕷️ Snap triggered: '+[...snapEvents].join(', '));
    showAnn('🕷️ SAMMY SNAPPED — +5000 coins & free brainrots!');
  }
  for(let i=densnap.particles.length-1;i>=0;i--){
    const p=densnap.particles[i];p.y+=p.vy*dt;p.x+=p.vx*dt;p.vy+=200*dt;p.life-=dt;
    if(p.life<=0||p.y>H+20)densnap.particles.splice(i,1);
  }
}
