<script>
const cv=document.getElementById('c'),g=cv.getContext('2d'),W=360,H=640,WW=640,WH=1500;cv.width=W;cv.height=H;
const F='Bungee, Impact, sans-serif';
const T=[{n:'Sneaky Croco',e:'🐊',p:25,i:1,c:'#b8c0cc',q:'Common'},{n:'Noodle Shark',e:'🦈',p:100,i:4,c:'#4fd16a',q:'Rare'},{n:'Laptopini Frogini',e:'🐸',p:400,i:14,c:'#3ea0ff',q:'Epic'},{n:'Toaster Moth',e:'🦋',p:1500,i:50,c:'#c46bff',q:'Legendary'},{n:'Disco Gorilla',e:'🦍',p:6000,i:180,c:'#ff9d2e',q:'Mythic'}];
const pick=()=>{const r=Math.random();return r<.45?0:r<.75?1:r<.92?2:r<.985?3:4};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const ORDER=[3,7,2,6,1,5,0,4],TS=2.5,SP=60,TRAVEL=(WH-110)/SP;
let isOwner=true,lobby=null,code='',phase='boot',room=null,myBase=null,myPeer=null,claimAt=1e18,full=false,hue=Math.floor(Math.random()*360),coins=30,carry=null,msg='',msgT=0,time=0,rate=0,cx=0,cy=0;
const me={x:255,y:1240},mySl=Array(6).fill(null),gone=new Set(),walkers=[];
// Manually spawned items on the runway (conveyor belt). Negative IDs avoid clashing with time-based belt items.
let runwaySpawns=[],spawnIdCounter=-1,spawnTarget='base'; // 'base' or 'runway'

// ── NPCs with human traits, thoughts & reactions ──
const NPC_NAMES=['Alex','Jordan','Sam','Riley','Casey','Morgan','Quinn','Avery','Jamie','Taylor'];
const NPC_TRAITS=[
  {id:'anxious',moods:['worried','nervous','relieved','panicked'],speed:0.9},
  {id:'chill',moods:['relaxed','bored','content','amused'],speed:0.7},
  {id:'hype',moods:['excited','pumped','FOMO','ecstatic'],speed:1.3},
  {id:'grumpy',moods:['annoyed','skeptical','petty','begrudging'],speed:0.85},
  {id:'curious',moods:['intrigued','observant','puzzled','fascinated'],speed:1.1},
  {id:'friendly',moods:['warm','helpful','chatty','encouraging'],speed:1.0}
];
const THOUGHTS={
  idle:[
    "Hmm, what should I grab next…","Is that a shark with noodles?","I need more coins.","This belt never stops.","Wonder if anyone's watching.","I should organize my base.","Brainrot economy is wild.","Did I lock my base?","These prices are getting ridiculous.","Maybe I should just watch for a bit."
  ],
  nearPlayer:[
    "Oh hey, another collector.","Don't steal my stuff… please.","Nice base you've got.","Are you going for the gorilla?","We're in this together, right?","That was a good grab.","Watch your step near the belt.","Competition is heating up."
  ],
  seeRare:[
    "WHOA is that legendary?!","No way — a mythic just dropped!","I need that. I NEED that.","Someone's about to snipe it.","Please don't let anyone take it…","That's the one. That's the one."
  ],
  snow:["Brr, it's freezing out here.","Snow on the belt? Really?","My shoes are soaked.","Kinda cozy actually…","Who turned on winter mode?"],
  rain:["Great, now it's raining.","At least the belt still works.","I should've brought an umbrella.","Rain makes everything dramatic.","Splash zone near the conveyor."],
  rainbow:["Okay the rainbow is pretty ngl.","Nature is showing off.","Is this a good omen?","Rainbow means rare drops… right?","Someone take a screenshot."],
  tacos:["TACOS?! From the sky?!","This is the best event ever.","I'm not even mad.","Catch one for me!","My diet is officially over."],
  buy:[
    "Nice pickup!","Oof, that cost a lot.","Smart buy.","I'd have gone for that too.","Your base is looking stacked.","Respect the grind."
  ],
  baseFull:["Base is packed. Time to upgrade.","No more slots… tough choices.","Maybe clear something weak.","Full house. Feels good."],
  lowCoins:["Coins are tight right now.","Can't afford much…","Saving up for something big.","Every coin counts."],
  greeting:["Hey!","'Sup.","You new here?","Welcome to the chaos.","Another day, another brainrot."]
};
function pickThought(cat){const a=THOUGHTS[cat]||THOUGHTS.idle;return a[Math.random()*a.length|0]}
function makeNpc(i){
  const trait=NPC_TRAITS[i%NPC_TRAITS.length];
  const name=NPC_NAMES[i%NPC_NAMES.length];
  const hue=(i*67+30)%360;
  // Spread around map, avoid center belt
  const side=i%2;
  const x=side?80+Math.random()*120:440+Math.random()*120;
  const y=120+Math.random()*(WH-240);
  return {
    id:i,name,trait:trait.id,speed:trait.speed,hue,
    x,y,tx:x,ty:y, // target wander point
    mood:trait.moods[0],
    thought:'',thoughtT:0,
    reactT:0, // cooldown between reactions
    walkT:2+Math.random()*4,
    face:side?1:-1, // facing direction
    energy:0.5+Math.random()*0.5,
    lastSeenRare:0
  };
}
const npcs=Array.from({length:6},(_,i)=>makeNpc(i));
function npcSay(npc,text,dur){
  npc.thought=text;npc.thoughtT=dur||3.5;npc.reactT=4+Math.random()*3;
}
function npcReactEvent(evName){
  const lines=THOUGHTS[evName];if(!lines)return;
  // 2–3 NPCs react with slight delay personality
  const shuffled=[...npcs].sort(()=>Math.random()-0.5).slice(0,2+Math.random()*2|0);
  shuffled.forEach((npc,i)=>{
    setTimeout(()=>{
      if(npc.reactT>0)return;
      const line=lines[Math.random()*lines.length|0];
      // personality twist
      if(npc.trait==='grumpy'&&Math.random()<0.4)npcSay(npc,"Ugh. "+line,3.2);
      else if(npc.trait==='hype')npcSay(npc,line.toUpperCase().replace(/[!.]/g,'!!!'),3.5);
      else if(npc.trait==='anxious')npcSay(npc,line+" …right?",3.5);
      else npcSay(npc,line,3.2);
    },300+i*600+Math.random()*400);
  });
}
function updateNpcs(dt){
  const now=performance.now()/1000;
  for(const npc of npcs){
    npc.reactT=Math.max(0,npc.reactT-dt);
    npc.thoughtT=Math.max(0,npc.thoughtT-dt);
    if(npc.thoughtT<=0)npc.thought='';

    // Wander
    npc.walkT-=dt;
    if(npc.walkT<=0){
      npc.walkT=3+Math.random()*6;
      // Prefer open grass, avoid deep into bases sometimes visit belt area
      const roll=Math.random();
      if(roll<0.25){ // approach belt to "window shop"
        npc.tx=clamp(280+Math.random()*80,50,WW-50);
        npc.ty=clamp(100+Math.random()*(WH-200),50,WH-50);
      }else if(roll<0.4){ // visit a random base entrance
        const b=B[Math.random()*B.length|0];
        npc.tx=b.s?b.bx-30:b.bx+210;
        npc.ty=b.by+150;
      }else{
        npc.tx=clamp(50+Math.random()*(WW-100),50,WW-50);
        npc.ty=clamp(80+Math.random()*(WH-160),50,WH-50);
      }
    }
    const dx=npc.tx-npc.x,dy=npc.ty-npc.y,d=Math.hypot(dx,dy);
    if(d>4){
      const sp=55*npc.speed*npc.energy;
      npc.x+=dx/d*Math.min(d,sp*dt);
      npc.y+=dy/d*Math.min(d,sp*dt);
      if(Math.abs(dx)>2)npc.face=dx>0?1:-1;
    }

    // Thoughts: idle chatter
    if(npc.reactT<=0&&npc.thoughtT<=0&&Math.random()<0.004){
      const distMe=Math.hypot(npc.x-me.x,npc.y-me.y);
      if(distMe<90)npcSay(npc,pickThought('nearPlayer'),3);
      else if(coins<40&&Math.random()<0.3)npcSay(npc,pickThought('lowCoins'),3);
      else if(mySl.every(s=>s!=null)&&Math.random()<0.25)npcSay(npc,pickThought('baseFull'),3);
      else npcSay(npc,pickThought('idle'),3);
    }

    // React to rare/mythic on nearby belt
    if(npc.reactT<=0){
      for(const b of beltItems()){
        if(b.t>=3&&Math.hypot(b.x||320,b.y-npc.y)<120&&Math.abs((b.x||320)-npc.x)<180){
          if(now-npc.lastSeenRare>8){
            npc.lastSeenRare=now;
            npcSay(npc,pickThought('seeRare'),3.5);
            // Hype NPCs rush toward it a bit
            if(npc.trait==='hype'||npc.trait==='curious'){
              npc.tx=320+(Math.random()-0.5)*40;npc.ty=b.y;npc.walkT=2;
            }
            break;
          }
        }
      }
    }

    // Greet player once when first close
    if(!npc.greeted&&Math.hypot(npc.x-me.x,npc.y-me.y)<70){
      npc.greeted=true;
      npcSay(npc,pickThought('greeting'),2.5);
    }
  }
}
function drawNpcs(){
  for(const npc of npcs){
    // Body
    g.fillStyle='hsl('+npc.hue+',65%,50%)';
    g.fillRect(npc.x-9,npc.y-2,18,15);
    // Head
    g.fillStyle='#f5d0a9';
    g.fillRect(npc.x-7,npc.y-15,14,13);
    // Eyes
    g.fillStyle='#160d33';
    g.fillRect(npc.x-4+(npc.face>0?1:-1),npc.y-11,2.5,3);
    g.fillRect(npc.x+1+(npc.face>0?1:-1),npc.y-11,2.5,3);
    // Name tag
    g.fillStyle='rgba(10,5,30,.75)';
    const nw=npc.name.length*5.2+6;
    g.fillRect(npc.x-nw/2,npc.y+16,nw,11);
    tx(npc.name,npc.x,npc.y+22,8,'#cfc3ff');
    // Thought bubble
    if(npc.thought&&npc.thoughtT>0){
      const alpha=Math.min(1,npc.thoughtT*2);
      g.globalAlpha=alpha;
      const words=npc.thought,maxW=120;
      g.font='9px system-ui,sans-serif';
      // Simple wrap
      const lines=[];let cur='';
      for(const w of words.split(' ')){
        const test=cur?cur+' '+w:w;
        if(g.measureText(test).width>maxW&&cur){lines.push(cur);cur=w}else cur=test;
      }
      if(cur)lines.push(cur);
      const bw=Math.min(maxW+10,Math.max(...lines.map(l=>g.measureText(l).width))+12);
      const bh=10+lines.length*11;
      const bx=npc.x-bw/2,by=npc.y-28-bh;
      g.fillStyle='rgba(255,255,255,.95)';
      g.beginPath();
      // rounded rect approx
      g.fillRect(bx,by,bw,bh);
      // little tail
      g.beginPath();g.moveTo(npc.x-4,by+bh);g.lineTo(npc.x,by+bh+6);g.lineTo(npc.x+4,by+bh);g.fill();
      g.fillStyle='#160d33';
      g.textAlign='center';g.textBaseline='middle';
      lines.forEach((l,i)=>g.fillText(l,npc.x,by+8+i*11));
      g.globalAlpha=1;
    }
  }
}
const B=[];
for(let s=0;s<2;s++)for(let r=0;r<4;r++){const bx=s?410:40,by=70+r*340;
  B.push({bx,by,s,sl:[0,1,2,3,4,5].map(k=>({x:bx+50+(k%2)*90,y:by+60+(k>>1)*90}))})}
const say=s=>{msg=s;msgT=2.2};
let annT=0,annText='';const seenG=new Set();
let timer=null; // {text, endAt} endAt = performance.now()/1000 deadline
const showAnn=t=>{annText=t;annT=6};
const gift=(n,id)=>{if(seenG.has(id))return;seenG.add(id);coins+=n;showAnn('🎁 Free coins for everyone! +'+n)};
const EV_LEN=90;let ev={},forced={};const prevAct={};
const setForced=d=>{const n=Date.now()/1000;
  if(d.id==='none'){for(const k in EVN)forced[k]={off:true,until:n+300}}
  else if(d.off)forced[d.id]={off:true,until:n+300};
  else forced[d.id]={start:n,until:n+60,off:false}};
const drops=Array.from({length:140},()=>({x:Math.random()*W,y:Math.random()*H,l:8+Math.random()*8,s:520+Math.random()*280}));
const EVN={snow:['❄️ Snow event! Everything is frosty','The snow stopped'],rain:['🌧️ Rain event! It is pouring','The rain stopped'],rainbow:['🌈 Rainbow event! Look at the sky','The rainbow faded'],tacos:['🌮 Raining tacos!','The tacos stopped']};
// ── DEN SNAP cutscene (Sammy Spyder snap) ──
let densnap=null; // {t0, phase, shake, flash, particles:[]}
let snapEvents=new Set(["rainbow"]); // events triggered when Sammy snaps (multi-select)
const DEN_LINES=[
  'The ground rumbles…',
  'Someone is coming.',
  'SPYDER SAMMY',
  'He raises his hand…',
  'SNAP.',
  'Everything changes.'
];
function startDenSnap(){
  if(densnap)return;
  document.getElementById('adm').style.display='none';
  densnap={t0:performance.now()/1000,phase:0,shake:0,flash:0,particles:[],rewarded:false};
