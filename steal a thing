let densnap=null,snapEvents=new Set(["rainbow"]);
function startDenSnap(){
  if(!isOwner||densnap)return;
  document.getElementById('adm').style.display='none';
  densnap={t0:performance.now()/1000,phase:0,shake:0,flash:0,particles:[],rewarded:false};
  say('🕷️ DEN SNAP incoming…');
  npcs.forEach((n,i)=>setTimeout(()=>{
    const lines=["Wait what is that?!","SAMMY?!","Oh no oh no oh no","Is this admin abuse?!","GET TO COVER","I can't believe this"];
    npcSay(n,lines[i%lines.length],4);
  },800+i*400));
