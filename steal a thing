const ORDER=[3,7,2,6,1,5,0,4],TS=2.5,SP=60,TRAVEL=(WH-110)/SP;
let isOwner=false,lobby=null,code='',phase='boot',room=null,myBase=null,myPeer=null,claimAt=1e18,full=false,hue=Math.floor(Math.random()*360),coins=30,carry=null,msg='',msgT=0,time=0,rate=0,cx=0,cy=0;
const me={x:255,y:1240},mySl=Array(6).fill(null),gone=new Set(),walkers=[];
const B=[];
for(let s=0;s<2;s++)for(let r=0;r<4;r++){const bx=s?410:40,by=70+r*340;
  B.push({bx,by,s,sl:[0,1,2,3,4,5].map(k=>({x:bx+50+(k%2)*90,y:by+60+(k>>1)*90}))})}
const say=s=>{msg=s;msgT=2.2};
let annT=0,annText='';const seenG=new Set();
const showAnn=t=>{annText=t;annT=6};
const gift=(n,id)=>{if(seenG.has(id))return;seenG.add(id);coins+=n;showAnn('🎁 Free coins for everyone! +'+n)};
const EV_LEN=90;let ev={},forced={};const prevAct={};
const setForced=d=>{const n=Date.now()/1000;
  if(d.id==='none'){for(const k in EVN)forced[k]={off:true,until:n+300}}
