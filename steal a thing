<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Steal a Thing</title>
<link href="https://fonts.googleapis.com/css2?family=Bungee&display=swap" rel="stylesheet">
<style>
:root{--bg:#160d33;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0}
body{background:var(--bg);display:flex;align-items:center;justify-content:center;overflow:hidden;touch-action:none}
canvas{width:min(100vw,56.25vh);width:min(100vw,56.25dvh);aspect-ratio:9/16;height:auto;touch-action:none}
.gate,#gate{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(10,5,30,.9);font-family:'Bungee',Impact,sans-serif;z-index:5}
.card{background:#2a1a5e;color:#fff;padding:24px;border-radius:12px;width:min(300px,84vw);text-align:center;display:flex;flex-direction:column;gap:12px}
.card p{margin:0;font:13px system-ui,sans-serif;color:#cfc3ff}
#ci{font:32px 'Bungee',Impact,sans-serif;text-align:center;letter-spacing:.3em;text-transform:uppercase;padding:8px;border:0;border-radius:8px;background:#160d33;color:#ffd23f;width:100%;box-sizing:border-box}
#cb{font:18px 'Bungee',Impact,sans-serif;padding:12px;border:0;border-radius:8px;background:#ff4d8d;color:#160d33}
#cb:disabled{opacity:.6}
#ce{min-height:16px;font:13px system-ui,sans-serif;color:#ff9db8}
</style></head><body>
<canvas id="c"></canvas>
<div id="gate"><div class="card"><b>Join a game</b><p>Enter the code shown at the top right of your friend's screen.</p><input id="ci" maxlength="4" autocomplete="off" autocapitalize="characters" spellcheck="false"><button id="cb">Join</button><div id="ce"></div></div></div>
<script>
const cv=document.getElementById('c'),g=cv.getContext('2d'),W=360,H=640,WW=640,WH=1500;cv.width=W;cv.height=H;
const F='Bungee, Impact, sans-serif';
const T=[{n:'Sneaky Croco',e:'🐊',p:25,i:1,c:'#b8c0cc',q:'Common'},{n:'Noodle Shark',e:'🦈',p:100,i:4,c:'#4fd16a',q:'Rare'},{n:'Laptopini Frogini',e:'🐸',p:400,i:14,c:'#3ea0ff',q:'Epic'},{n:'Toaster Moth',e:'🦋',p:1500,i:50,c:'#c46bff',q:'Legendary'},{n:'Disco Gorilla',e:'🦍',p:6000,i:180,c:'#ff9d2e',q:'Mythic'}];
const pick=()=>{const r=Math.random();return r<.45?0:r<.75?1:r<.92?2:r<.985?3:4};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const ORDER=[3,7,2,6,1,5,0,4],TS=2.5,SP=60,TRAVEL=(WH-110)/SP;
let lobby=null,code='',phase='boot',room=null,myBase=null,myPeer=null,claimAt=1e18,full=false,hue=Math.floor(Math.random()*360),coins=30,carry=null,msg='',msgT=0,time=0,rate=0,cx=0,cy=0;
const me={x:255,y:1240},mySl=Array(6).fill(null),gone=new Set();
const B=[];
for(let s=0;s<2;s++)for(let r=0;r<4;r++){const bx=s?410:40,by=70+r*340;
  B.push({bx,by,s,sl:[0,1,2,3,4,5].map(k=>({x:bx+50+(k%2)*90,y:by+60+(k>>1)*90}))})}
const say=s=>{msg=s;msgT=2.2};
const keys={};let ptr=null;
addEventListener('keydown',e=>keys[e.key.toLowerCase()]=1);
addEventListener('keyup',e=>keys[e.key.toLowerCase()]=0);
const pos=e=>{const r=cv.getBoundingClientRect();return{x:(e.clientX-r.left)*W/r.width,y:(e.clientY-r.top)*H/r.height}};
cv.addEventListener('pointerdown',e=>{const q=pos(e);ptr=q;cv.setPointerCapture(e.pointerId)});
cv.addEventListener('pointermove',e=>{if(ptr)ptr=pos(e)});
addEventListener('pointerup',()=>ptr=null);
addEventListener('pointercancel',()=>ptr=null);
const others=()=>room?room.peers().filter(p=>!p.sameTab&&p.kind==='viewer'):[];
const takenMap=()=>{const m={};others().forEach(p=>{const b=p.presence.base;if(typeof b==='number')m[b]=p});return m};
const typeAt=n=>{const h=Math.sin(n*127.1)*43758.5453,r=h-Math.floor(h);return r<.45?0:r<.75?1:r<.92?2:r<.985?3:4};
function beltItems(){const now=Date.now()/1000,o=[];for(let n=Math.floor((now-TRAVEL)/TS);n<=Math.floor(now/TS);n++){const y=60+(now-n*TS)*SP;if(y>WH-50||y<60||gone.has(n))continue;o.push({n,y,t:typeAt(n)})}return o}
function goBase(k){myBase=k;const b=B[k];me.x=b.s?b.bx-25:b.bx+215;me.y=b.by+150;say('You are in Base '+(k+1))}
function assign(){
  if(!room||performance.now()<claimAt)return;
  const mp=room.peers().find(p=>p.sameTab);if(!mp)return;myPeer=mp.peer;
  const tk=takenMap();
  if(myBase!=null){const c=tk[myBase];if(c&&c.peer<myPeer){myBase=null;mySl.fill(null);room.presence({base:null}).catch(()=>{})}else return}
  const f=ORDER.find(k=>!tk[k]);
  if(f==null){full=true;return}
  full=false;goBase(f);room.presence({base:f,h:hue}).catch(()=>{});
}
const newCode=()=>Array.from({length:4},()=>'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[Math.random()*32|0]).join('');
function begin(r,c){
  room=r;code=c;phase='play';
  room.on('buy',m=>{if(m.data&&typeof m.data.n==='number')gone.add(m.data.n)});
  room.onPeers(assign);claimAt=performance.now()+1800;setInterval(assign,1000);
  setInterval(()=>{if(room.connected())room.presence({x:Math.round(me.x),y:Math.round(me.y),sl:mySl.map(t=>t==null?-1:t)}).catch(()=>{})},100);
  lobby.presence({sess:1}).catch(()=>{});
}
async function tryCode(c){
  c=c.trim().toUpperCase();
  if(c.length<4)return 'Enter the 4-character code';
  let r;try{r=await lobby.join('g-'+c.toLowerCase())}catch(e){return 'Could not join, try again'}
  await new Promise(res=>setTimeout(res,1800));
  if(!r.peers().some(p=>!p.isMe&&p.kind==='viewer')){r.leave().catch(()=>{});return 'Wrong code'}
  begin(r,c);return '';
}
const gate=document.getElementById('gate'),ci=document.getElementById('ci'),cb=document.getElementById('cb'),ce=document.getElementById('ce');
async function submit(){cb.disabled=true;ce.textContent='Checking...';const e=await tryCode(ci.value);if(e){ce.textContent=e;cb.disabled=false}else gate.style.display='none'}
cb.onclick=submit;ci.onkeydown=e=>{if(e.key==='Enter')submit()};
(async()=>{
  try{lobby=window.claude?await claude.use('room'):null}catch(e){lobby=null}
  if(!lobby){phase='solo';goBase(3);return}
  await new Promise(res=>setTimeout(res,1800));
  if(lobby.peers().some(p=>!p.isMe&&p.kind==='viewer'&&p.presence.sess)){phase='code';gate.style.display='flex';ci.focus();return}
  const c=newCode();
  try{begin(await lobby.join('g-'+c.toLowerCase()),c)}catch(e){phase='solo';goBase(3)}
})();
setTimeout(()=>{if(phase==='boot'){phase='solo';goBase(3)}},11000);
function update(dt){
  time+=dt;
  let dx=(keys.arrowright||keys.d?1:0)-(keys.arrowleft||keys.a?1:0),dy=(keys.arrowdown||keys.s?1:0)-(keys.arrowup||keys.w?1:0);
  if(!dx&&!dy&&ptr){const vx=ptr.x+cx-me.x,vy=ptr.y+cy-me.y,d=Math.hypot(vx,vy);if(d>6){dx=vx/d;dy=vy/d}}
  else{const l=Math.hypot(dx,dy)||1;dx/=l;dy/=l}
  const sp=carry!=null?125:150;
  me.x=clamp(me.x+dx*sp*dt,34,WW-34);me.y=clamp(me.y+dy*sp*dt,34,WH-34);
  rate=mySl.reduce((a,t)=>a+(t!=null?T[t].i:0),0);coins+=rate*dt;
  if(myBase!=null)for(const b of beltItems()){
    if(Math.hypot(320-me.x,b.y-me.y)<30&&coins>=T[b.t].p){
      const k=mySl.indexOf(null);
      if(k>=0){coins-=T[b.t].p;mySl[k]=b.t;gone.add(b.n);if(room)room.emit('buy',{n:b.n}).catch(()=>{});say('Bought '+T[b.t].n)}else say('Your base is full');
    }
  }
  if(myBase==null&&phase!=='code')say(phase==='boot'?'Looking for a game...':full?'All 8 bases are taken. Watching until one opens.':'Finding your base...');
  msgT-=dt;cx=clamp(me.x-W/2,0,WW-W);cy=clamp(me.y-H/2,0,WH-H);
}
const frogImg=new Image();frogImg.src='data:image/jpeg;base64,';
const sharkImg=new Image();sharkImg.src='data:image/jpeg;base64,';
const mothImg=new Image();mothImg.src='data:image/jpeg;base64,';
const gorImg=new Image();gorImg.src='data:image/jpeg;base64,';
const IMG={'🐸':frogImg,'🦈':sharkImg,'🦋':mothImg,'🦍':gorImg};
const em=(s,x,y,z)=>{const im=IMG[s];if(im&&im.naturalWidth){const k=z*1.3;g.drawImage(im,x-k/2,y-k/2,k,k);return}g.font=z+'px sans-serif';g.textAlign='center';g.textBaseline='middle';g.fillText(s,x,y)};
const tx=(s,x,y,z,c,a)=>{g.font=z+'px '+F;g.textAlign=a||'center';g.textBaseline='middle';g.fillStyle=c;g.fillText(s,x,y)};
function pad(x,y,c){g.fillStyle=c;g.fillRect(x-24,y-24,48,48);g.fillStyle='rgba(0,0,0,.25)';g.fillRect(x-24,y+18,48,6)}
function tag(t,x,y){g.fillStyle='rgba(10,5,30,.8)';g.fillRect(x-30,y-11,60,22);g.fillStyle=t.c;g.fillRect(x-30,y-11,60,3);tx(t.q,x,y-1,7,t.c);tx(t.n,x,y+7,6,'#fff')}
function draw(){
  g.fillStyle='#160d33';g.fillRect(0,0,W,H);
  g.save();g.translate(-cx,-cy);
  g.fillStyle='#3fbf45';g.fillRect(0,0,WW,WH);
  g.fillStyle='#39b13f';for(let y=0;y<WH;y+=80)g.fillRect(0,y,WW,40);
  g.fillStyle='#8f0f1a';g.fillRect(262,24,116,WH-48);g.fillStyle='#d91e2b';g.fillRect(270,24,100,WH-48);
  g.fillStyle='#e8404c';for(let y=24+(time*60)%40-40;y<WH-24;y+=40)g.fillRect(270,Math.max(24,y),100,8);
  const tk=takenMap();
  B.forEach((b,i)=>{
    const mine=i===myBase,pl=tk[i],sl=mine?mySl:(pl&&pl.presence.sl)||[];
    g.fillStyle='#3b4757';g.fillRect(b.bx,b.by+8,190,308);
    g.fillStyle=mine?'#5f8a86':pl?'#6b7280':'#4b5260';g.fillRect(b.bx,b.by,190,300);
    g.fillStyle='#b8c4d4';g.fillRect(b.bx+(b.s?0:184),b.by+120,6,60);g.fillRect(b.bx+20,b.by+288,70,4);g.fillRect(b.bx+100,b.by+288,60,4);
    tx('Base '+(i+1)+(mine?' (you)':pl?'':' (open)'),b.bx+95,b.by+326,9,'#8a0f1a');
    if(mine||pl)b.sl.forEach((s,k)=>{pad(s.x,s.y,mine?'#3f736b':'#565d6a');const t=sl[k];
      if(t!=null&&t>=0){const d=T[t];if(!mine){g.fillStyle=d.c;g.fillRect(s.x-15,s.y-15,30,30)}em(d.e,s.x,s.y,26);if(mine)tx('+'+d.i,s.x,s.y+30,8,'#fff')}});
  });
  g.fillStyle='#5a2d17';g.fillRect(0,0,WW,24);g.fillRect(0,WH-24,WW,24);g.fillRect(0,0,24,WH);g.fillRect(WW-24,0,24,WH);
  g.fillStyle='#3d1d0e';g.fillRect(0,20,WW,4);g.fillRect(0,WH-24,WW,4);g.fillRect(20,0,4,WH);g.fillRect(WW-24,0,4,WH);
  g.fillStyle='#1a1a1a';g.fillRect(290,0,60,26);g.fillRect(290,WH-26,60,26);g.fillStyle='#8a8a8a';g.fillRect(310,6,20,14);g.fillRect(310,WH-20,20,14);
  for(const b of beltItems()){const t=T[b.t];g.fillStyle=t.c;g.fillRect(302,b.y-18,36,36);em(t.e,320,b.y,26);tag(t,320,b.y-32);tx('🪙'+t.p,320,b.y+30,10,coins>=t.p?'#b6ffe6':'#ffd0da')}
  for(const p of others()){const q=p.presence;if(q.x==null)continue;g.fillStyle='hsl('+(q.h||200)+',70%,55%)';g.fillRect(q.x-10,q.y-2,20,16);g.fillStyle='#ffd23f';g.fillRect(q.x-8,q.y-16,16,14);g.fillStyle='#160d33';g.fillRect(q.x-4,q.y-11,3,4);g.fillRect(q.x+2,q.y-11,3,4)}
  g.fillStyle='hsl('+hue+',70%,55%)';g.fillRect(me.x-10,me.y-2,20,16);g.fillStyle='#ffd23f';g.fillRect(me.x-8,me.y-16,16,14);g.fillStyle='#160d33';g.fillRect(me.x-4,me.y-11,3,4);g.fillRect(me.x+2,me.y-11,3,4);
  if(carry!=null){em(T[carry].e,me.x,me.y-34,24);tag(T[carry],me.x,me.y-56)}
  g.restore();
  g.fillStyle='rgba(10,5,30,.85)';g.fillRect(0,0,W,30);
  tx('🪙 '+Math.floor(coins),10,16,14,'#ffd23f','left');tx('+'+rate+'/s',W/2,16,13,'#3ee6b0');if(code)tx('Code '+code+'  👥'+room.peers().filter(p=>p.kind==='viewer'&&!(p.isMe&&!p.sameTab)).length+'/8',W-8,16,10,'#ffd23f','right');
  const mx=W-46,my=36,sx=36/WW,sy=84/WH;
  g.fillStyle='rgba(10,5,30,.6)';g.fillRect(mx-2,my-2,40,88);g.fillStyle='#3fbf45';g.fillRect(mx,my,36,84);g.fillStyle='#d91e2b';g.fillRect(mx+16,my,4,84);
  B.forEach((b,i)=>{g.fillStyle=i===myBase?'#ffd23f':tk[i]?'#3ea0ff':'#6b7280';g.fillRect(mx+b.bx*sx,my+b.by*sy,10,16)});
  g.fillStyle='#fff';g.fillRect(mx+me.x*sx-2,my+me.y*sy-2,4,4);
  if(msgT>0){g.globalAlpha=Math.min(1,msgT);tx(msg,W/2,240,15,'#fff');g.globalAlpha=1}
  if(time<8){tx('Drag to move',W/2,420,14,'#fff');tx('Walk into characters on the red carpet to buy them.',W/2,442,9,'#fff');tx('Friends who join get their own base (up to 8).',W/2,458,9,'#fff')}
}
let last=performance.now();
(function loop(n){const dt=Math.min(.05,(n-last)/1000);last=n;update(dt);draw();requestAnimationFrame(loop)})(last);
</script></body></html>
