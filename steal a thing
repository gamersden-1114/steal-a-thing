  if(ev.tacos)for(const t of tacos){t.y+=t.s*dt;t.r+=t.v*dt;if(t.y>H+30){t.y=-30;t.x=Math.random()*W}}
  if(ev.rain)for(const d of drops){d.y+=d.s*dt;d.x-=d.s*.15*dt;if(d.y>H+10){d.y=-10;d.x=Math.random()*(W+60)}}
  if(ev.snow)for(const f of flakes){f.y+=f.s*dt;f.x+=Math.sin(time+f.p)*18*dt;if(f.y>H+4){f.y=-4;f.x=Math.random()*W}}
  let dx=(keys.arrowright||keys.d?1:0)-(keys.arrowleft||keys.a?1:0),dy=(keys.arrowdown||keys.s?1:0)-(keys.arrowup||keys.w?1:0);
  if(!dx&&!dy&&ptr){const vx=ptr.x+cx-me.x,vy=ptr.y+cy-me.y,d=Math.hypot(vx,vy);if(d>6){dx=vx/d;dy=vy/d}}
  else{const l=Math.hypot(dx,dy)||1;dx/=l;dy/=l}
  if(joy.id!=null){dx=joy.x;dy=joy.y}
  const sp=carry!=null?125:150;
  me.x=clamp(me.x+dx*sp*dt,34,WW-34);me.y=clamp(me.y+dy*sp*dt,34,WH-34);
  rate=mySl.reduce((a,t)=>a+(t!=null?T[t].i:0),0);coins+=rate*dt;
  for(let i=walkers.length-1;i>=0;i--){
    const w=walkers[i],p=w.wp[w.i],vx=p.x-w.x,vy=p.y-w.y,d=Math.hypot(vx,vy);
    if(d<4){if(++w.i>=w.wp.length){if(w.base===myBase&&mySl[w.k]==null)mySl[w.k]=w.t;walkers.splice(i,1)}}
    else{const m=Math.min(d,50*dt);w.x+=vx/d*m;w.y+=vy/d*m}
  }
  if(myBase==null&&phase!=='menu')say(phase==='boot'?'Looking for a game...':full?'All 8 bases are taken. Watching until one opens.':'Finding your base...');
  msgT-=dt;annT-=dt;cx=clamp(me.x-W/2,0,WW-W);cy=clamp(me.y-H/2,0,WH-H);
}
